# Runtime secrets — DO NOT COMMIT REAL VALUES
ETH_RPC_URL=
ARB_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=

# V2-compatible venues — use only addresses verified for the selected chain/deployment.
# No router addresses are hardcoded by the application.
V2_VENUE_A_ROUTER=
V2_VENUE_B_ROUTER=

# Instadapp integration — populate from current official developer configuration
INSTADAPP_API_KEY=
INSTADAPP_APP_ID=

# Instapool v4 — deployment addresses must be independently verified before use.
# Supported upstream connector source variants: Ethereum, Arbitrum, Optimism, Polygon, Avalanche.
INSTAPOOL_V4_CONNECTOR_ETHEREUM=
INSTAPOOL_V4_CONNECTOR_ARBITRUM=
INSTAPOOL_V4_CONNECTOR_OPTIMISM=
INSTAPOOL_V4_CONNECTOR_POLYGON=
INSTAPOOL_V4_CONNECTOR_AVALANCHE=
# Explicit operator verification gate; keep false until each configured address is verified.
INSTAPOOL_V4_DEPLOYMENT_VERIFIED=false

# Wallet/auth
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
AUTH_SECRET=

# Strategy controls
TARGET_PROFIT_USD=100
MIN_NET_PROFIT_USD=5
SAFETY_RESERVE_USD=2
MAX_PATHS_PER_CYCLE=25
MAX_CYCLES=100
LIVE_EXECUTION=false
