# Runtime secrets — DO NOT COMMIT REAL VALUES
ETH_RPC_URL=
ARB_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
AVALANCHE_RPC_URL=

# V2-compatible venues — use only addresses verified for the selected chain/deployment.
# LIVE_QUOTE_ROUTES is a JSON array. Each route must provide a real router/path,
# amountInRaw, and current operator-supplied USD prices for the input/output tokens.
# Known chains can omit chainName/nativeSymbol. Additional EVM chains may be added
# by supplying chainId + chainName + nativeSymbol + a validated RPC env variable.
# Example shape (DO NOT use these example addresses/prices in production):
# LIVE_QUOTE_ROUTES=[{"venue":"UniswapV2","chainId":1,"rpcUrlEnv":"ETH_RPC_URL","router":"0x...","path":["0x...","0x..."],"amountInRaw":"1000000","tokenInDecimals":6,"tokenOutDecimals":18,"tokenInUsd":1,"tokenOutUsd":2500,"gasUsd":5,"slippageUsd":2}]
LIVE_QUOTE_ROUTES=[]
FLASH_LIQUIDITY=[]

V2_VENUE_A_ROUTER=
V2_VENUE_B_ROUTER=

# Instadapp integration — populate from current official developer configuration
INSTADAPP_API_KEY=
INSTADAPP_APP_ID=

# Hummingbot bridge — persistent worker only; never expose these as NEXT_PUBLIC_* values.
HUMMINGBOT_API_URL=http://localhost:8000
HUMMINGBOT_API_USER=
HUMMINGBOT_API_PASS=
HUMMINGBOT_GATEWAY_URL=http://localhost:15888
HUMMINGBOT_GATEWAY_PASSPHRASE=
# Comma-separated connector aliases managed by Hummingbot credential profiles.
# Hummingbot itself remains the source of truth for the available connector universe.
HUMMINGBOT_CEX_CONNECTORS=binance,gate_io,okx,kucoin
# Comma-separated DEX/Gateway adapters expected for the current deployment.
HUMMINGBOT_DEX_CONNECTORS=uniswap,pancakeswap
# Optional additional network names for the unified control-plane scope.
HUMMINGBOT_NETWORKS=ethereum,arbitrum,base,bsc,optimism,polygon,avalanche
HUMMINGBOT_BRIDGE_ENABLED=false
HUMMINGBOT_LIVE_TRADING_ENABLED=false
HUMMINGBOT_EXECUTION_AUTHORIZED=false

# Instapool v4 — deployment addresses must be independently verified before use.
INSTAPOOL_V4_CONNECTOR_ETHEREUM=
INSTAPOOL_V4_CONNECTOR_ARBITRUM=
INSTAPOOL_V4_CONNECTOR_OPTIMISM=
INSTAPOOL_V4_CONNECTOR_POLYGON=
INSTAPOOL_V4_CONNECTOR_AVALANCHE=
INSTAPOOL_V4_VERIFIED_ETHEREUM=false
INSTAPOOL_V4_VERIFIED_ARBITRUM=false
INSTAPOOL_V4_VERIFIED_OPTIMISM=false
INSTAPOOL_V4_VERIFIED_POLYGON=false
INSTAPOOL_V4_VERIFIED_AVALANCHE=false
INSTAPOOL_V4_BYTECODE_HASH_ETHEREUM=
INSTAPOOL_V4_BYTECODE_HASH_ARBITRUM=
INSTAPOOL_V4_BYTECODE_HASH_OPTIMISM=
INSTAPOOL_V4_BYTECODE_HASH_POLYGON=
INSTAPOOL_V4_BYTECODE_HASH_AVALANCHE=

# Wallet/auth
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
AUTH_SECRET=

# Read-only remote MCP gateway authorization. Never expose this in client-side env.
MCP_ACCESS_TOKEN=

# Strategy controls
TARGET_PROFIT_USD=100
MIN_NET_PROFIT_USD=5
SAFETY_RESERVE_USD=2
MAX_PATHS_PER_CYCLE=25
MAX_CYCLES=100

# Automation / keeper orchestration.
# These settings may enable discovery/revalidation workflows; they do not by themselves
# authorize live transactions. Keep AUTONOMOUS_SUBMISSION=false and
# INCLUSION_INCENTIVE_ENABLED=false until separately audited and explicitly approved.
AUTOMATION_ENABLED=false
AUTOMATION_PROVIDERS=
AUTOMATION_TRIGGER_MODE=DISCOVERY_ONLY
AUTONOMOUS_SUBMISSION=false
INCLUSION_INCENTIVE_ENABLED=false
MAX_ADDITIONAL_GAS_USD=0
MAX_INCLUSION_INCENTIVE_USD=0
REQUIRE_CONTROLLED_FORK_ATTESTATION=true
REQUIRE_EXPLICIT_EXECUTION_AUTHORIZATION=true
FLASHBOTS_SUBMISSION_ENABLED=false
GELATO_AUTOMATION_ENABLED=false
CHAINLINK_AUTOMATION_ENABLED=false

# Production execution remains fail-closed.
LIVE_EXECUTION=false
CONTROLLED_FORK_VALIDATED=false
CONTROLLED_FORK_VALIDATION_ID=
ATOMIC_REPAYMENT_VALIDATED=false
PRODUCTION_WALLET_AUTHORIZED=false
PRODUCTION_RISK_LIMITS_VALIDATED=false
PRODUCTION_PROFITABILITY_VALIDATED=false
PRODUCTION_SLIPPAGE_GAS_VALIDATED=false
PRODUCTION_EXECUTION_PATH_ENABLED=false
PRODUCTION_KILL_SWITCH_ENABLED=true
