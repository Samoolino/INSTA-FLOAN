# Runtime secrets — DO NOT COMMIT REAL VALUES
ETH_RPC_URL=
ARB_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
AVALANCHE_RPC_URL=

# V2-compatible venues — use only addresses verified for the selected chain/deployment.
# LIVE_QUOTE_ROUTES is a JSON array. Each route must provide a real router/path,
# amountInRaw, and current operator-supplied USD prices for the input/output tokens.
# Example shape (DO NOT use these example addresses/prices in production):
# LIVE_QUOTE_ROUTES=[{"venue":"UniswapV2","chainId":1,"rpcUrlEnv":"ETH_RPC_URL","router":"0x...","path":["0x...","0x..."],"amountInRaw":"1000000","tokenInDecimals":6,"tokenOutDecimals":18,"tokenInUsd":1,"tokenOutUsd":2500,"gasUsd":5,"slippageUsd":2}]
LIVE_QUOTE_ROUTES=[]

V2_VENUE_A_ROUTER=
V2_VENUE_B_ROUTER=

# Instadapp integration — populate from current official developer configuration
INSTADAPP_API_KEY=
INSTADAPP_APP_ID=

# Instapool v4 — deployment addresses must be independently verified before use.
INSTAPOOL_V4_CONNECTOR_ETHEREUM=
INSTAPOOL_V4_CONNECTOR_ARBITRUM=
INSTAPOOL_V4_CONNECTOR_OPTIMISM=
INSTAPOOL_V4_CONNECTOR_POLYGON=
INSTAPOOL_V4_CONNECTOR_AVALANCHE=
INSTAPOOL_V4_VERIFIED_ETHEREUM=false
INSTAPOOL_V4_VERIFIED_ARBITRUM=false
INSTAPOOL_V4_VERIFIED_OPTIMISM=false
INSTAPOOL_V4_VERIFIED_POLYGON=false
INSTAPOOL_V4_VERIFIED_AVALANCHE=false
INSTAPOOL_V4_BYTECODE_HASH_ETHEREUM=
INSTAPOOL_V4_BYTECODE_HASH_ARBITRUM=
INSTAPOOL_V4_BYTECODE_HASH_OPTIMISM=
INSTAPOOL_V4_BYTECODE_HASH_POLYGON=
INSTAPOOL_V4_BYTECODE_HASH_AVALANCHE=

# Wallet/auth
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
AUTH_SECRET=

# Strategy controls
TARGET_PROFIT_USD=100
MIN_NET_PROFIT_USD=5
SAFETY_RESERVE_USD=2
MAX_PATHS_PER_CYCLE=25
MAX_CYCLES=100

# Production execution remains fail-closed.
LIVE_EXECUTION=false
CONTROLLED_FORK_VALIDATED=false
CONTROLLED_FORK_VALIDATION_ID=
ATOMIC_REPAYMENT_VALIDATED=false
PRODUCTION_WALLET_AUTHORIZED=false
PRODUCTION_RISK_LIMITS_VALIDATED=false
PRODUCTION_PROFITABILITY_VALIDATED=false
PRODUCTION_SLIPPAGE_GAS_VALIDATED=false
PRODUCTION_EXECUTION_PATH_ENABLED=false
PRODUCTION_KILL_SWITCH_ENABLED=true
